* =============================================================
* UNDERWATER PIEZOELECTRIC EQUIVALENT MODEL
* =============================================================

* -------------------------------------------------------------
* USER SETTINGS
* -------------------------------------------------------------

* materialSel: 1 = PZT, 2 = PVDF
.param materialSel=1

* modelSel: 0 = old/original, 1 = updated Eq. (28)-(32)
.param modelSel=0

* Number of identical piezoelectric elements
.param N=1

* Piezo area, dB level and frequency
.param A=2e-3
.param SPL_dB=230
.param f=42

* =============================================================
* CONSTANTS
* =============================================================

.param pi0=3.141592653589793
.param eps0=8.8541878128e-12
.param Zw=1.5e6
.param p_ref=1e-6

.param w={2*pi0*f}


* =============================================================
* MATERIAL PROPERTIES
* =============================================================

.param h={if(materialSel==1,200e-6,100e-6)}
.param E3={if(materialSel==1,5e10,2.5e9)}
.param rho={if(materialSel==1,7.8e3,1.78e3)}
.param epsr={if(materialSel==1,3.8e3,12.5)}
.param d33={if(materialSel==1,650e-12,30e-12)}
.param c={if(materialSel==1,4000,2250)}


* =============================================================
* UNDERWATER ACOUSTIC PRESSURE
* =============================================================

.param pw_rms={p_ref*exp(ln(10)*SPL_dB/20)}
.param pw_amp={sqrt(2)*pw_rms}


* =============================================================
* MECHANICAL / ACOUSTIC QUANTITIES
* =============================================================

.param Lm={h/(E3*A)}
.param Cm={rho*A*h}
.param Rm={1/(rho*c*A)}

.param Cp1={epsr*eps0*A/h}

.param Yw={A*Zw}
.param Fw={A*pw_amp}

.param Ywm={Yw+1/Rm}
.param Rwm={1/Ywm}


* =============================================================
* OLD / ORIGINAL MODEL
* =============================================================

.param old_x={w*Cm*Rwm}
.param old_smallTerm={1+old_x*old_x}

.param Req_old={Rwm/(d33*d33*w*w*old_smallTerm)}
.param Ceq_old={d33*d33*old_smallTerm/(Rwm*Rwm*Cm)}
.param Leq_old={Lm/(d33*d33*w*w)}

.param Veq_old={Fw/(w*d33*sqrt(Ywm*Ywm+(w*Cm)*(w*Cm)))}

.param Cp_old={Cp1}


* =============================================================
* UPDATED EQ. (28)-(32) MODEL
* =============================================================

.param Req_new={Lm*Lm*Ywm/(d33*d33)}
.param Ceq_new={d33*d33/Lm}
.param Leq_new={Lm*Lm*Cm/(d33*d33)}

.param Veq_new={Fw*Lm/d33}

.param Cp_new={Cp1-d33*d33/Lm}


* =============================================================
* SELECT ACTIVE SINGLE-PIEZO MODEL
* =============================================================

.param Req={if(modelSel==1,Req_new,Req_old)}
.param Ceq={if(modelSel==1,Ceq_new,Ceq_old)}
.param Leq={if(modelSel==1,Leq_new,Leq_old)}
.param Veq={if(modelSel==1,Veq_new,Veq_old)}
.param Cp={if(modelSel==1,Cp_new,Cp_old)}


* =============================================================
* SINGLE PIEZO OPEN-CIRCUIT VOLTAGE
* =============================================================

.param Xseries={w*Leq-1/(w*Ceq)}
.param Xcp={-1/(w*Cp)}

.param Voc_calc={Veq*abs(Xcp)/sqrt(Req*Req+(Xseries+Xcp)*(Xseries+Xcp))}


* =============================================================
* SINGLE PIEZO OUTPUT IMPEDANCE
*
* Zout = Zseries || Zcp
*
* Zseries = Req + j*Xseries
* Zcp     = j*Xcp
* =============================================================

.param Zden={Req*Req+(Xseries+Xcp)*(Xseries+Xcp)}

.param Zout_Re={Req*Xcp*Xcp/Zden}

.param Zout_Im={Xcp*(Req*Req+Xseries*(Xseries+Xcp))/Zden}

.param Zout_mag={sqrt(Zout_Re*Zout_Re+Zout_Im*Zout_Im)}


* =============================================================
* N IDENTICAL PIEZOS IN SERIES
* =============================================================
*
* Req -> N*Req
* Leq -> N*Leq
* Ceq -> Ceq/N
* Cp  -> Cp/N
* Veq -> N*Veq
*
* =============================================================

.param Req_eqS={N*Req}
.param Ceq_eqS={Ceq/N}
.param Leq_eqS={N*Leq}
.param Cp_eqS={Cp/N}
.param Veq_eqS={N*Veq}


* -------------------------------------------------------------
* SERIES ARRAY REACTANCES
* -------------------------------------------------------------

.param Xseries_eqS={w*Leq_eqS-1/(w*Ceq_eqS)}
.param Xcp_eqS={-1/(w*Cp_eqS)}


* -------------------------------------------------------------
* SERIES ARRAY OPEN-CIRCUIT VOLTAGE
* -------------------------------------------------------------

.param Voc_eqS={Veq_eqS*abs(Xcp_eqS)/sqrt(Req_eqS*Req_eqS+(Xseries_eqS+Xcp_eqS)*(Xseries_eqS+Xcp_eqS))}


* -------------------------------------------------------------
* SERIES ARRAY OUTPUT IMPEDANCE
* -------------------------------------------------------------

.param Zden_eqS={Req_eqS*Req_eqS+(Xseries_eqS+Xcp_eqS)*(Xseries_eqS+Xcp_eqS)}

.param Zout_Re_eqS={Req_eqS*Xcp_eqS*Xcp_eqS/Zden_eqS}

.param Zout_Im_eqS={Xcp_eqS*(Req_eqS*Req_eqS+Xseries_eqS*(Xseries_eqS+Xcp_eqS))/Zden_eqS}

.param Zout_mag_eqS={sqrt(Zout_Re_eqS*Zout_Re_eqS+Zout_Im_eqS*Zout_Im_eqS)}


* =============================================================
* N IDENTICAL PIEZOS IN PARALLEL
* =============================================================
*
* Req -> Req/N
* Leq -> Leq/N
* Ceq -> N*Ceq
* Cp  -> N*Cp
* Veq -> Veq
*
* =============================================================

.param Req_eqP={Req/N}
.param Ceq_eqP={N*Ceq}
.param Leq_eqP={Leq/N}
.param Cp_eqP={N*Cp}
.param Veq_eqP={Veq}


* -------------------------------------------------------------
* PARALLEL ARRAY REACTANCES
* -------------------------------------------------------------

.param Xseries_eqP={w*Leq_eqP-1/(w*Ceq_eqP)}
.param Xcp_eqP={-1/(w*Cp_eqP)}


* -------------------------------------------------------------
* PARALLEL ARRAY OPEN-CIRCUIT VOLTAGE
* -------------------------------------------------------------

.param Voc_eqP={Veq_eqP*abs(Xcp_eqP)/sqrt(Req_eqP*Req_eqP+(Xseries_eqP+Xcp_eqP)*(Xseries_eqP+Xcp_eqP))}


* -------------------------------------------------------------
* PARALLEL ARRAY OUTPUT IMPEDANCE
* -------------------------------------------------------------

.param Zden_eqP={Req_eqP*Req_eqP+(Xseries_eqP+Xcp_eqP)*(Xseries_eqP+Xcp_eqP)}

.param Zout_Re_eqP={Req_eqP*Xcp_eqP*Xcp_eqP/Zden_eqP}

.param Zout_Im_eqP={Xcp_eqP*(Req_eqP*Req_eqP+Xseries_eqP*(Xseries_eqP+Xcp_eqP))/Zden_eqP}

.param Zout_mag_eqP={sqrt(Zout_Re_eqP*Zout_Re_eqP+Zout_Im_eqP*Zout_Im_eqP)}


* =============================================================
* BASIC MODEL MEASUREMENTS
* =============================================================

.meas tran Req_result PARAM {Req}
.meas tran Ceq_result PARAM {Ceq}
.meas tran Leq_result PARAM {Leq}
.meas tran Cp_result PARAM {Cp}
.meas tran Veq_result PARAM {Veq}

.meas tran Voc_result PARAM {Voc_calc}
.meas tran f_result PARAM {f}
.meas tran db_result PARAM {SPL_dB}
.meas tran Lp_result PARAM {Lp}
.meas tran Ls_result PARAM {Ls}
.meas tran Ctotal_result PARAM {Ctotal}
.meas tran Cb_result PARAM {Cb}
.meas tran BestLp_result PARAM {BestLp}
.meas tran BestLs_result PARAM {BestLs}

.meas tran pressure_peak_result PARAM {pw_amp}
.meas tran Veq_per_Pa_result PARAM {Veq/pw_amp}

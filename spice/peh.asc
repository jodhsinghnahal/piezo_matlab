TEXT 3696 16 Left 2 !.tran 0 5.025 5 uic
TEXT 3232 16 Left 2 !.param Rload=5.994843e+04\n.param Crect=1uF\n.param Rsw= 84\n.param C1=1.9800e-08\n.param Li=0.0470
TEXT 3224 240 Left 2 ;.step param C1 list 1n 10n 20n 45n\n.step param Li list 0.047 0.1 0.5 0.01 1\n.step dec param Rload 0.1k 100meg 3
TEXT 3224 -232 Left 2 ;*Use old model\n.param Leq = 6.797433e+01\n.param Req = 5.196815e+08\n.param Ceq = 5.791988e-07\n.param Veq = 7.973054e+05\n.param f = 42\n.param Cp = 3.364591e-07
TEXT 3688 -232 Left 2 ;*Use new model\n.param Leq = 2.953846e-08\n.param Req = 6.191716e-01\n.param Ceq = 2.112500e-07\n.param Veq = 2.752084e+01\n.param f = 42\n.param Cp = 1.252091e-07
TEXT 4448 64 Left 2 ;.include component_sweep.lib
TEXT 4096 -672 Left 2 !.model 1 ako:TIP31C\n.model 2 ako:TIP32C\n.model 3 ako:BAV199HY\n \n.model 4 ako:BSS4130A\n.model 5 ako:BSS5130A\n.model 6 ako:MBR0520L\n.model 7 ako:BAT54\n.model 8 ako:BAS40-06HY\n.model 9 ako:BAV199UM\n.model 10 ako:RB168VAM-60\n.model 11 ako:BAT54AHY\n.model 12 ako:CMDSH-4E\n.model 13 ako:UPSC600\n.model 14 ako:MBRS130L\n \n.param npn = 4\n.param pnp = 5\n.param Diode = 3\n.param Diode2 = 6
TEXT 3712 152 Left 2 !.include equiv_model.lib

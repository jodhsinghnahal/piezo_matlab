TEXT 4416 -256 Left 2 ;.model 1 ako:BSS4130A\n.model 2 ako:BSS5130A\n.model 3 ako:MBR0520L\n \n.param npn = 1\n.param pnp = 2\n.param Diode = 3
TEXT 3736 280 Left 2 !.include tlv3691.lib
TEXT 3792 2496 Left 2 !K5 L57 L58 1
TEXT 4096 2504 Left 2 !K6 L59 L60 1
TEXT 5344 2056 Left 2 !K7 L51 L62 1

; ============================================================
; TRANSFORMER SWEEP
; ============================================================

; 0 = ideal 0.5 ratio
; 1 = Hammond 140REX
; 2 = Triad A-70J
; 3 = Triad A-64J
; 4 = Hammond 850EA reversed
; 5 = Hammond 140PEX reversed
; 6 = Hammond 140QEX 1:1

.step param XFMR list 0 1 2 3 4 5 6

.param Lp=table(XFMR, 0,1, 1,3.62, 2,2, 3,0.38, 4,2.27, 5,55, 6,10.62)
.param Ls=table(XFMR, 0,0.25, 1,0.88, 2,0.3986, 3,0.152, 4,0.757, 5,13.75, 6,10.62)

.param Rp=table(XFMR, 0,0, 1,72.4, 2,50, 3,10, 4,68, 5,190, 6,72.4)
.param Rs=table(XFMR, 0,0, 1,18.2, 2,10, 3,4, 4,27, 5,58, 6,72.4)

.param Kxfmr=table(XFMR, 0,1, 1,0.995, 2,0.995, 3,0.995, 4,0.995, 5,0.995, 6,0.995)

K15 L53 L54 {Kxfmr}
K16 L2 L3 {Kxfmr}
 
.param Rsec=1e6

.param L_series1 = 1/((2*pi*f)**2 * Cp)
.param L_series2 = 1/((2*pi*f)**2 * (Cp + Ceq))
.param BestLp={if(modelSel==1,L_series2,L_series1)}
.param Ctotal = 1/((2*pi*f)**2 * Lp)
.param Cb = {Ctotal-Cp}
.param Rp2=20
.param Rs2=5
.param BestLs = {BestLp*n_turns*n_turns}
